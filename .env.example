# SSL Certificate Configuration (optional)
# FQDN for the Landscape server
LANDSCAPE_FQDN=landscape.example.com

# Let's Encrypt DNS Authorization (optional)
# Set ACME_DNS_PROVIDER to enable (cf, aws, gd, etc.)
# Then set provider-specific credentials as additional ACME_* vars; the ACME_
# prefix is removed before they reach acme.sh (ACME_CF_Token -> CF_Token).
# See: https://github.com/acmesh-official/acme.sh/wiki/dnsapi
#
# ACME_SERVER selects the CA (default: letsencrypt). Use letsencrypt_test to
# try your setup against Let's Encrypt staging without hitting rate limits.
# ACME_SERVER=letsencrypt_test
#
# Example for Cloudflare:
# ACME_DNS_PROVIDER=cf
# ACME_CF_Token=your_cloudflare_api_token
#
# Example for Route53:
# ACME_DNS_PROVIDER=aws
# ACME_AWS_ACCESS_KEY_ID=your_key
# ACME_AWS_SECRET_ACCESS_KEY=your_secret
#
# Example for GoDaddy:
# ACME_DNS_PROVIDER=gd
# ACME_GD_Key=your_key
# ACME_GD_Secret=your_secret
#
# If not set, generates self-signed certificate
