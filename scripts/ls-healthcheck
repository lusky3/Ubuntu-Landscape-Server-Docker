#!/bin/bash
# Healthy only if every supervised program is RUNNING (not STARTING, BACKOFF,
# STOPPED or FATAL) and the public endpoint answers.
set -euo pipefail

status=$(supervisorctl -c /etc/supervisor/supervisord.conf status || true)
if [ -z "$status" ] || grep -v ' RUNNING' <<<"$status" | grep -q .; then
  echo "unhealthy: $(grep -v ' RUNNING' <<<"$status" | head -3)" >&2
  exit 1
fi
curl -fsk -o /dev/null https://localhost/ping
